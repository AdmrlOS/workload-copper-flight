+    /// The exact completed CPU readback shared with the Copper ZED source.
+    /// Default/reset state has no observation. Cloning a handle does not copy pixels.
+    pub(crate) fn observed_depth(&self) -> Option<(u64, CuHandle<Vec<u16>>)> {
